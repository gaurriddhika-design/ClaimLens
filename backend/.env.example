# Copy to .env and fill only providers you actually use. Never commit .env.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
SEARCH_PROVIDER=
SEARCH_API_KEY=
TAVILY_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./claimlens.db
FRONTEND_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
MAX_CLAIMS=20
REQUEST_TIMEOUT_SECONDS=15
MAX_TEXT_CHARS=100000
MAX_URL_RESPONSE_BYTES=2000000
